# Local ATC config / runtime state (use config.example.json)
atc/config.json
atc/flow_state.json
atc/ownship_inject.json
atc/ownship_inject.json.tmp
atc/weather_inject.json
atc/weather_inject.json.tmp
atc/traffic_inject.json
atc/traffic_inject.json.tmp
atc/state.json
atc/tts_usage.json
atc/__pycache__/
atc/**/__pycache__/
*.pyc

# Google / Azure credentials
atc/secrets/*
!atc/secrets/.gitignore
!atc/secrets/README.txt

# Generated kneeboard output (source generator stays)
atc/kneeboard/*.pdf

# Backups the zone editor leaves next to the file it rewrites
*.json.bak

# Large reference packs for the zone editor (drop locally under tools/overlays/)
tools/overlays/*
!tools/overlays/README.txt

# FAA SUA cache used by tools/import_nttr_agencies.py
tools/_nttr_sua.geojson

# Scratch downloads / plate probes (never commit)
atc/_tmp*
atc/**/_tmp*

# Logs / editor junk
*.log
.DS_Store
Thumbs.db
.vs/
.idea/
*.user

# Cursor IDE (local rules, plans)
.cursor/
